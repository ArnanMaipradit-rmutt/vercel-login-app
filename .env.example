# ========================================================
# Environment Variables สำหรับ Next.js Login App
# ========================================================

# 1. JWT Secret Key (ใส่ข้อความสุ่มยาวๆ สำหรับสร้าง Session Token)
JWT_SECRET=super_secret_jwt_key_vercel_login_app_2024_secure

# 2. Supabase Database Connection URL
# ได้จาก: Supabase Project -> Settings -> Database -> Connection string -> URI (Mode: Transaction หรือ Session)
# ตัวอย่างรูปแบบ:
# postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# หรือ Direct connection:
# postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=
